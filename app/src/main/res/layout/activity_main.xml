<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp" android:background="@color/nova_bg" android:gravity="center_horizontal">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NOVA" android:textColor="@color/nova_blue" android:textSize="42sp" android:textStyle="bold" android:letterSpacing=".12" android:layout_marginTop="50dp"/>
    <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:background="@drawable/panel" android:text="Készen állok. Mondd: Nova…" android:textColor="@color/nova_text" android:textSize="20sp" android:gravity="center" android:minHeight="110dp"/>
    <TextView android:id="@+id/transcriptText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="A felismert parancs itt jelenik meg." android:textColor="#B8C8E6" android:textSize="16sp" android:gravity="center"/>
    <Button android:id="@+id/listenButton" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="36dp" android:text="Hangvezérlés indítása" android:textSize="18sp"/>
    <Button android:id="@+id/settingsButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:text="Mikrofon beállításai"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="Példa: „Nova, nyisd meg a térképet”\nA Nova megszólítás után mondj egy parancsot." android:textColor="#91A7CC" android:textSize="14sp" android:gravity="center"/>
</LinearLayout>
